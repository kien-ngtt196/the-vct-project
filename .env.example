VCT_DB_NAME=vct_db
VCT_DB_USER=postgres
VCT_DB_PASSWORD=replace_with_your_local_password
VCT_DB_HOST=localhost
VCT_DB_PORT=5432
# For hosted PostgreSQL, set DATABASE_URL in the deployment environment.
# It takes precedence over the local VCT_DB_* settings.
# To load private .env.neon settings locally, set VCT_USE_NEON=1 before starting the app.
# Optional: migrate a specific scraper snapshot
# VCT_INPUT_JSON=data/raw/events_YYYYMMDDTHHMMSSZ.json
